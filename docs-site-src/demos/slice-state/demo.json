{
  "script": "plugin/scripts/slice-state.mjs",
  "args": ["--ticket", "T-1", "--actor", "demo", "--spec", "docs/specs/T-1-demo.md"],
  "cwd": "work",
  "env": { "GH_STUB": "$ROOT/plugin/scripts/fixtures/gh-stub.mjs", "GH_STUB_FIXTURE": "$FIXTURE/gh.json" },
  "setup": [
    "git init -q -b main --bare origin.git",
    "git init -q -b main work",
